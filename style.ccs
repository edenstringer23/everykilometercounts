body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f8f8f8;
    color: #333;
}

.hero {
    text-align: center;
    padding: 80px 20px;
    background-color: #0047ab;
    color: white;
}

.hero h1 {
    font-size: 60px;
}

.hero h2 {
    font-size: 30px;
}

img {
    display: block;
    width: 80%;
    margin: 40px auto;
    border-radius: 10px;
}

section {
    width: 80%;
    margin: auto;
    padding-bottom: 50px;
}
