body {
    margin: 0;
    font-family: Arial, sans-serif;
    background-color: #f5f5f5;
}

.hero {
    background-color: #0057b8;
    color: white;
    text-align: center;
    padding: 80px 20px;
}

.hero h1 {
    font-size: 60px;
    margin-bottom: 10px;
}

.hero h2 {
    font-size: 30px;
}

img {
    width: 80%;
    display: block;
    margin: 40px auto;
    border-radius: 12px;
}

section {
    max-width: 1000px;
    margin: auto;
    padding: 20px;
}
